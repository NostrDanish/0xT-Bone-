<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Exposes filesDir/logs/ for log file sharing via FileProvider -->
    <files-path name="logs" path="logs/" />
    <!-- Exposes filesDir/recordings/ for voice-note sharing via FileProvider -->
    <files-path name="recordings" path="recordings/" />
    <!-- Short-lived PNG cards exported to other apps through a read-only URI. -->
    <cache-path name="share_cards" path="share_cards/" />
</paths>
